{
    "name": "furious-developer/lara-bit",
    "description": "Artisan command to scaffold Blade views (pages, layouts, components) from customizable starter templates",
    "type": "library",
    "keywords": [
        "laravel",
        "views",
        "blade",
        "template",
        "generator",
        "scaffold",
        "layout",
        "component",
        "php",
        "artisan",
        "command"
    ],
    "homepage": "https://github.com/ragib-mrb/larabit",
    "license": "MIT",
    "authors": [
        {
            "name": "Ragib Mrb",
            "email": "ragib.mrb@gmail.com",
            "homepage": "https://github.com/ragib-mrb"
        }
    ],
    "support": {
        "issues": "https://github.com/ragib-mrb/larabit/issues",
        "source": "https://github.com/ragib-mrb/larabit"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "FuriousDeveloper\\LaraBit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FuriousDeveloper\\LaraBit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel":{
            "providers":[
                "FuriousDeveloper\\LaraBit\\LaraBitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
