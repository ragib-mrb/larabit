{
    "name": "ragib-mrb/larabit",
    "description": "Create Laravel views (blade template) using 'php artisan' command-line interface",
    "type": "library",
    "keywords": [
        "laravel",
        "views",
        "blade",
        "template",
        "generator",
        "php",
        "artisan",
        "command"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ragib Mrb",
            "email": "ragib.mrb@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "RagibMrb\\LaraBit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RagibMrb\\LaraBit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel":{
            "providers":[
                "RagibMrb\\LaraBit\\LaraBitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
